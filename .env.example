# ============================================================
# payNEXT Environment Configuration
# Copy this file to .env for local development and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Required application settings
NODE_ENV=production
PORT=3000

# Required database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=paynext_db
DB_SSL=false

# Required JWT signing secret (at least 32 bytes; startup fails if shorter)
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# Optional rate limits (requests per 15-minute window)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MONEY_MAX=20
RATE_LIMIT_READ_MAX=100

# Required in production for browser clients; comma-separated exact origins.
# Empty means no cross-origin browser origins are allowed in production.
ALLOWED_ORIGINS=https://paynextt.me,https://www.paynextt.me

# Required by docker-compose/Caddy for HTTPS certificate provisioning
DOMAIN=paynextt.me
WWW_DOMAIN=www.paynextt.me
