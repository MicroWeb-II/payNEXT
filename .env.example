# =============================================================================
# payNEXT environment template
#
# Local development: copy to `.env` and adjust. Never commit `.env`.
# Staging/production: do NOT copy this file to a server. The deploy workflow
# writes `.env` on the host from the GitHub Environment's secrets
# (see docs/runbooks/deploy-staging.md). It is never part of the deploy bundle.
# =============================================================================

# --- Release -----------------------------------------------------------------
# Immutable image tag to run. CI sets this to the Git SHA; "local" builds from
# source with `docker compose up --build`. "latest" is never used.
IMAGE_TAG=local
# Registry/namespace for images, e.g. ghcr.io/microweb-ii (CI sets this).
IMAGE_REGISTRY=paynext

# --- Application -------------------------------------------------------------
NODE_ENV=production
PORT=3000
# info | debug | warn | error. Logs are JSON on stdout.
LOG_LEVEL=info

# --- Public hostnames (Caddy obtains Let's Encrypt certificates for these) ----
# Use `localhost` locally (Caddy then uses its own internal CA).
DOMAIN=localhost
# Optional second hostname, e.g. www.example.com. Leave empty if unused.
WWW_DOMAIN=
# Exact browser origins allowed to call the API cross-origin, comma-separated.
# The bundled web app is same-origin and needs nothing here. Empty = closed.
ALLOWED_ORIGINS=

# --- Database ----------------------------------------------------------------
# DB_HOST defaults to the bundled `db` container. Set it (and DB_SSL=true) only
# when using a managed PostgreSQL instance instead.
DB_HOST=db
DB_PORT=5432
DB_USER=paynext
# Required. Generate with: openssl rand -base64 24
DB_PASSWORD=change-me
DB_NAME=paynext
DB_SSL=false
# Verify the database TLS certificate (keep true for managed databases).
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# --- Authentication ----------------------------------------------------------
# Required, at least 32 bytes; the API refuses to start otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Access token lifetime (seconds) and refresh session lifetime (days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt work factor (minimum 12 is enforced).
BCRYPT_COST=12
# Send the refresh cookie only over HTTPS (defaults to true in production).
COOKIE_SECURE=true

# --- Rate limits (requests per window, per IP and per user) ------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MONEY_MAX=20
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_READ_MAX=100

# --- Money -------------------------------------------------------------------
# Largest single transaction amount, in major units.
MAX_TRANSACTION_AMOUNT=1000000
IDEMPOTENCY_TTL_HOURS=24

# --- Observability -----------------------------------------------------------
METRICS_ENABLED=true
# Optional bearer token required by /metrics (internal network only).
METRICS_TOKEN=

# --- Backups -----------------------------------------------------------------
# Host directory for dumps, base backups and archived WAL.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# Cron schedule (UTC) for the daily backup.
BACKUP_SCHEDULE=0 2 * * *
