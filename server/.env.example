# Local API environment template. Never copy this file to production as .env;
# production secrets are written on the host by the deployment secret step.
NODE_ENV=development
PORT=3000

# PostgreSQL. For docker-compose, DB_HOST is set to `db` by compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=paynext_db
DB_SSL=false

# Required: generate a random secret of at least 32 bytes.
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# Optional request limits per 15-minute window.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MONEY_MAX=20
RATE_LIMIT_READ_MAX=100

# Comma-separated exact origins. Empty is closed by default in production.
ALLOWED_ORIGINS=http://localhost:3000

# Required by Caddy in production; use real public DNS names.
DOMAIN=localhost
WWW_DOMAIN=localhost
