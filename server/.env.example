# Running the API directly with `npm run dev` (outside Docker).
# See the root .env.example for every option and its documentation.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=paynext
DB_PASSWORD=change-me
DB_NAME=paynext
DB_SSL=false

# Required: at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Development allows http://localhost:3000, :5173 and 127.0.0.1:4173 by default.
ALLOWED_ORIGINS=
COOKIE_SECURE=false
